# Copy this file to `.env` and adjust. The server loads server/.env on startup.

# Inventory
TOTAL_STOCK=100

# Sale window. Accepts an ISO date string OR epoch milliseconds.
# Leave SALE_START unset to start "now"; leave SALE_END unset for start + 2h.
# SALE_START=2026-06-03T10:00:00+08:00
# SALE_END=2026-06-03T12:00:00+08:00

# Store backend: memory | redis | mongo
STORE=memory

# Connection strings (only used by the matching STORE)
# REDIS_URL=redis://127.0.0.1:6379
# MONGO_URL=mongodb://127.0.0.1:27017/flashsale

# Server
PORT=3000
# ENABLE_ADMIN=true
